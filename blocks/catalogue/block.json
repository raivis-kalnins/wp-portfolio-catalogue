{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wp-portfolio-catalogue/catalogue",
  "version": "1.0.0",
  "title": "Portfolio Catalogue",
  "category": "widgets",
  "icon": "portfolio",
  "description": "Display a responsive portfolio with project categories, search and image galleries.",
  "keywords": ["portfolio", "projects", "gallery"],
  "textdomain": "wp-portfolio-catalogue",
  "attributes": {
    "columns": {"type": "number", "default": 3},
    "perPage": {"type": "number", "default": 6},
    "category": {"type": "string", "default": ""},
    "tag": {"type": "string", "default": ""},
    "projectIds": {"type": "array", "items": {"type": "number"}, "default": []},
    "filters": {"type": "boolean", "default": true},
    "search": {"type": "boolean", "default": true},
    "orderby": {"type": "string", "default": "date"},
    "order": {"type": "string", "default": "DESC"},
    "excerptWords": {"type": "number", "default": 22}
  },
  "supports": {"html": false, "align": ["wide", "full"]},
  "editorScript": "wppc-catalogue-editor",
  "style": "wppc-frontend",
  "editorStyle": "file:./editor.css"
}
